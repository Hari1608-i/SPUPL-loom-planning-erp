generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model AllocationAuditLog {
  id        Int      @id @default(autoincrement())
  user      String   @default("System")
  timestamp DateTime @default(now())
  old_plan  String?
  new_plan  String
  reason    String?
  action    String
  loom_no   Int
  design_no String
}

model BeamPreparationRequest {
  id                      Int       @id @default(autoincrement())
  loom_no                 Int
  design_no               String
  target_date             DateTime
  status                  String    @default("WAITING FOR WARPING")
  priority                String    @default("Medium")
  warping_vendor          String?
  warping_dc_no           String?
  warping_batch           String?
  sizing_vendor           String?
  sizing_dc_no            String?
  sizing_machine          String?
  vendor_name             String?
  vendor_beam             String?
  set_no                  String?
  beam_no                 String?
  required_meter          Float?
  actual_meter            Float?
  warping_remarks         String?
  sizing_remarks          String?
  warping_start_date      DateTime?
  warping_completion_date DateTime?
  sizing_start_date       DateTime?
  sizing_completion_date  DateTime?
  beam_ready_date         DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime
}

model BeamStockMaster {
  id                 Int      @id @default(autoincrement())
  date               DateTime @default(now())
  design_no          String
  vendor_name        String?
  party_beam_no      String?
  order_no           String?
  ibpo               String?
  customer           String?
  count              String?
  ends               Int?
  beam_dia           Int?
  beam_no            String
  beam_length        Float?
  available_meter    Float
  current_balance_meter Float?
  reserved_meter     Float?   @default(0)
  party              String?
  set_no             String?
  order_type         String?
  warp_dc_no         String?
  status             String   @default("Available")
  sizing_status      String?  @default("COMPLETED")
  loom_no_assigned   Int?
  beam_type          String?
  beam_width         Float?
  construction       String?
  location           String?
  ready_status       String?
  reed_count         String?
  remarks            String?
  reserved_for       String?
  reserved_status    String?
  reserved_date      DateTime?
  total_warped_meter Float?
  unit               String?
  warping_batch_no   String?
  net_wt             Float?
  tare               Float?
  gross_wt           Float?

  @@index([status])
}

model CompletedWarpHistory {
  id                     Int        @id @default(autoincrement())
  loom_no                Int
  design_no_sp_no        String
  start_date             DateTime
  end_date               DateTime
  warp_meter             Float
  total_production_meter Float
  running_days           Int
  avg_daily_production   Float
  efficiency_pct         Float
  unit                   String
  sort_change_type       String?
  LoomMaster             LoomMaster @relation(fields: [loom_no], references: [loom_no])
}

model Department {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
}

model DesignMaster {
  design_no_sp_no       String  @id
  construction          String?
  weft_colours          Int
  weft_colour_details   String?
  frames                Int
  reed_count            String?
  pick                  String?
  greige_width          String?
  total_ends            Int?
  reed_space_warp_width String
  weave_type            String
  beam_type             String
  crimp_percent         Float
  beam_dia              Int?
  epi                   Int?
  ppi                   Int?
  no_of_clr_warp        Int?
  no_of_clr_weft        Int?
  orders OrderMaster[]
  beamStocks BeamStock[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status String @default("ACTIVE")
  remarks String?
}

model LoginHistory {
  id         Int       @id @default(autoincrement())
  username   String
  loginTime  DateTime  @default(now())
  logoutTime DateTime?
  ipAddress  String?
  device     String?
  browser    String?
  status     String
}

model LoomMaster {
  loom_no              Int                    @id @default(autoincrement())
  loom_type            String?
  shed                 Int?
  shed_name            String?
  area                 Int?
  installed_date       String?
  rpm                  Int?
  act_rpm              Int?
  make                 String?
  model                String?
  motor_kw_hp          String?
  drive                String?
  control_panel        String?
  weft_colours         Int?
  beam_type            String?
  beam_dia             Int?
  installed_lever      Int?
  width                String?
  unit                 String?
  weave                String?
  frame_capacity       Int?
  max_weft_colours     Int?
  status               String                 @default("Available")
  remarks              String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now())
  createdBy            String                 @default("System")
  modifiedBy           String?
  CompletedWarpHistory CompletedWarpHistory[]
  LoomRunEntry         LoomRunEntry?
  PlannedAssignment    PlannedAssignment[]
  WarpPreparationProcess WarpPreparationProcess[]
}

model LoomRunEntry {
  id                  Int        @id @default(autoincrement())
  loom_no             Int        @unique
  design_no_sp_no     String?
  current_reed_no     String?
  current_pick        String?
  current_beam_no     String?
  set_no              String?
  beam_id             Int?
  order_no            String?
  customer_name       String?
  loom_start_date     DateTime
  warped_meter        Float
  daily_production    Float
  rpm                 Int?
  efficiency          Float?
  shift_hours         Float?
  working_hours       Float?
  machine_utilization Float?
  production_override Float?
  override_reason     String?
  next_plan_design    String?
  sort_change_type    String?
  prep_status         String?
  remarks             String?
  LoomMaster          LoomMaster @relation(fields: [loom_no], references: [loom_no])
}

model DailyProductionLog {
  id             Int      @id @default(autoincrement())
  date           DateTime @default(now())
  loom_no        Int
  design_no      String
  produced_meter Float
  rpm            Int?
  efficiency     Float?
  remarks        String?
  createdAt      DateTime @default(now())
}

model RunoutHistoryLog {
  id                   Int      @id @default(autoincrement())
  loom_no              Int
  design_no            String
  beam_no              String?
  calculation_date     DateTime @default(now())
  net_balance_meter    Float
  daily_production     Float
  rpm                  Int?
  efficiency           Float?
  effective_production Float
  expected_runout_date DateTime
  runout_source        String
  confidence_level     String
  user                 String?  @default("System")
  planner_override     Boolean  @default(false)
}

model PlannedAssignment {
  id                           Int        @id @default(autoincrement())
  loom_no                      Int
  current_design               String
  next_design                  String
  order_id                     Int?
  order_no                     String?
  customer_name                String?
  required_qty                 Float?
  required_reed_space          String?
  required_reed_count          String?
  planned_start_date           DateTime
  planned_warp_meter           Float
  planned_avg_daily_production Float
  status                       String     @default("NOT PLANNED")
  reserved_reed_id             Int?
  reserved_reed_no             String?
  reed_status                  String?    @default("PENDING")
  reserved_beam_id             Int?
  reserved_beam_no             String?
  reserved_set_no              String?
  beam_status                  String?    @default("PENDING")
  sizing_status                String?    @default("PENDING")
  readiness_status             String?    @default("WAITING FOR RESOURCE")
  planning_score               Float?     @default(0)
  expected_start_date          DateTime?
  expected_finish_date         DateTime?
  delay_days                   Int?       @default(0)
  delay_status                 String?    @default("ON TIME")
  blocker_reason               String?
  recommended_action           String?
  remarks                      String?
  planner_name                 String?
  confirmation_status          String?
  change_requested_by          String?
  change_requested_date        DateTime?
  change_request_remark        String?
  decline_remark               String?
  confirmed_by                 String?
  confirmed_date               DateTime?
  createdAt                    DateTime   @default(now())
  updatedAt                    DateTime   @default(now())
  LoomMaster                   LoomMaster @relation(fields: [loom_no], references: [loom_no])
  WarpPreparationProcess       WarpPreparationProcess[]
}

model RecommendationHistory {
  id               Int      @id @default(autoincrement())
  timestamp        DateTime @default(now())
  recommended_loom Int
  selected_loom    Int
  selected_design  String
  reason           String
  planner_name     String   @default("System")
}

model ReedStockMaster {
  id                 Int      @id @default(autoincrement())
  reed_no            String?
  reed_type          String?
  reed_count         String
  reed_space         String?
  reed_width         String?
  reed_dent          String?
  dents_per_inch     Int?
  total_dents        Int?
  reed_make          String?
  vendor             String?
  unit               String?
  location           String?
  available_qty      Int      @default(1)
  reserved_qty       Int      @default(0)
  running_qty        Int      @default(0)
  damaged_qty        Int      @default(0)
  total_qty          Int      @default(1)
  status             String   @default("Available")
  remarks            String?
  reserved_for_loom  Int?
  reserved_for_order String?
  reserved_for_design String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())
}

model ReedRequirement {
  id                  Int      @id @default(autoincrement())
  order_no            String?
  design_no           String
  loom_no             Int?
  required_reed_count String
  required_reed_space String?
  required_width      String?
  qty                 Int      @default(1)
  required_date       DateTime?
  priority            String   @default("URGENT")
  status              String   @default("REQUIRED")
  remarks             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now())
}

model RoleMaster {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  template    String?
}

model SystemAuditLog {
  id        Int      @id @default(autoincrement())
  username  String
  screen    String
  action    String
  oldValue  String?
  newValue  String?
  timestamp DateTime @default(now())
}

model User {
  id             Int       @id @default(autoincrement())
  employeeId     String    @unique
  employeeName   String
  username       String    @unique
  email          String?
  mobile         String?
  department     String?
  designation    String?
  password_hash  String
  role           String    @default("VIEWER")
  status         String    @default("ACTIVE")
  failedAttempts Int       @default(0)
  lastLogin      DateTime?
  permissions    String?
  remarks        String?
  createdBy      String    @default("System")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([department])
  @@index([role])
}

model OrderMaster {
  id                        Int       @id @default(autoincrement())
  order_no                  String?
  ibpo_no                   String?
  customer_name             String
  buyer_name                String?
  order_type                String?   @default("GREY")
  combo_pattern             String?
  finish                    String?
  design_no_sp_no           String
  designMaster              DesignMaster @relation(fields: [design_no_sp_no], references: [design_no_sp_no])
  construction              String?
  reed_count                String?
  weave_type                String?
  epi                       Int?
  ppi                       Int?
  total_ends                Int?
  beam_type                 String?
  frames                    Int?
  no_of_clr_warp            Int?
  no_of_clr_weft            Int?
  uom                       String    @default("Meters")
  
  order_qty                 Float
  grey_qty                  Float?
  warp_qty                  Float?
  beam_capacity             Float?
  required_beams            Int?
  
  planned_warp_beams        Int?
  current_beam_planned      Int       @default(0)
  beam_prepared             Int       @default(0)
  
  planned_loom_count        Int?
  avg_production_per_loom   Float?
  estimated_production_days Float?
  expected_completion_date  DateTime?
  
  sizing_planned_date       DateTime?
  sizing_completed_date     DateTime?
  weaving_planned_date      DateTime?
  weaving_start_date        DateTime?
  weaving_completion_date   DateTime?
  expected_dispatch_date    DateTime?
  actual_dispatch_date      DateTime?
  
  priority                  String    @default("NORMAL")
  planning_status           String    @default("Planning Pending")
  approval_status           String    @default("APPROVED")
  yarn_status               String?   @default("APPROVED")
  sizing_status             String?   @default("APPROVED")
  beam_status               String?   @default("BEAM NOT AVAILABLE")
  produced_qty              Float     @default(0)
  short_excess_qty          Float?    @default(0)
  order_completion_status   String    @default("ACTIVE")
  actual_completion_date    DateTime?
  completion_remarks        String?
  completed_by              String?
  approved_by               String?
  approval_date             DateTime?
  warp_confirmed_qty        Float?    @default(0)
  warp_balance_qty          Float?    @default(0)
  delay_status              String?
  order_received_date       DateTime? @default(now())
  target_delivery_date      DateTime?
  
  status                    String    @default("ORDER RECEIVED")
  remarks                   String?
  
  createdBy                 String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  BeamRequirements BeamRequirement[]
}

model OrderCompletionHistory {
  id                        Int       @id @default(autoincrement())
  order_no                  String    @unique
  ibpo_no                   String?
  customer_name             String
  buyer_name                String?
  design_no_sp_no           String
  construction              String?
  order_qty                 Float
  grey_qty                  Float?
  warp_qty                  Float?
  uom                       String    @default("Meters")
  order_received_date       DateTime?
  target_delivery_date      DateTime?
  
  // Yarn Details
  required_yarn_qty         Float?
  confirmed_yarn_qty        Float?
  balance_yarn_qty          Float?
  yarn_confirmation_date    DateTime?
  
  // Sizing Details
  sizing_required_qty       Float?
  sizing_confirmed_qty      Float?
  sizing_date               DateTime?
  sizing_completion_date    DateTime?
  
  // Beam Details
  beams_used                String?
  
  // Weaving Details
  looms_used                String?
  loom_start_date           DateTime?
  loom_end_date             DateTime?
  daily_production_avg      Float?
  total_produced_meter      Float?
  
  // Completion Details
  final_status              String    @default("COMPLETED")
  produced_qty              Float
  short_excess_qty          Float?    @default(0)
  actual_completion_date    DateTime  @default(now())
  delay_days                Int?      @default(0)
  delay_reason              String?
  corrective_action         String?
  planner_remarks           String?
  completed_by              String?
  createdAt                 DateTime  @default(now())
}


model BeamRequirement {
  id             Int      @id @default(autoincrement())
  order_id       Int
  order_no       String
  design_no      String
  beam_no        Int
  beam_type      String?
  beam_dia       Int?
  required_meter Float
  required_ends  Int?
  beam_width     String?
  status         String   @default("Pending")
  beam_stock_id  Int?
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  OrderMaster OrderMaster @relation(fields: [order_id], references: [id])
}

model BeamStock {
  id                     Int        @id @default(autoincrement())
  beamNo                 String     @unique
  vendorBeamNo           String?    @unique
  warpingDcNo            String?
  warpingVendor          String?
  warpingBatchNo         String?
  setNo                  String?
  beamSerialNo           String?
  beamType               String?
  beamDiameter           Float?
  beamWidth              Float?
  beamLength             Float?
  beamWeight             Float?
  beamStatus             BeamStatus @default(NOT_PLANNED)
  beamLocation           String?
  unit                   String?
  remarks                String?
  designNo               String?
  design                 DesignMaster? @relation(fields: [designNo], references: [design_no_sp_no])
  orderNumber            String?
  ibpoNumber             String?
  customer               String?
  orderQuantity          Float?
  warpQuantity           Float?
  requiredBeamQuantity   Int?
  totalEnds              Int?
  warpMeter              Float?
  currentBalanceMeter    Float?
  beamCapacity           Float?
  reservedMeter          Float?
  runningMeter           Float?
  balanceMeter           Float?
  warpingStatus          WarpingStatus @default(NOT_PLANNED)
  sizingStatus           SizingStatus  @default(NOT_PLANNED)
  loomStatus             LoomStatus    @default(NOT_ALLOCATED)
  beamPlannedDate        DateTime?
  warpingStartDate       DateTime?
  warpingCompletionDate  DateTime?
  sizingStartDate        DateTime?
  sizingCompletionDate   DateTime?
  beamReadyDate          DateTime?
  loomAllocationDate     DateTime?
  productionStartDate    DateTime?
  productionCompletionDate DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  histories              BeamHistory[]
}

enum BeamStatus {
  NOT_PLANNED
  PLANNED
  WARPING_RUNNING
  WARPING_COMPLETED
  SIZING_RUNNING
  SIZING_COMPLETED
  READY
  RESERVED
  RUNNING
  COMPLETED
  ARCHIVED
}

enum WarpingStatus {
  NOT_PLANNED
  PLANNED
  RUNNING
  COMPLETED
}

enum SizingStatus {
  NOT_PLANNED
  PLANNED
  RUNNING
  COMPLETED
  READY
}

enum LoomStatus {
  NOT_ALLOCATED
  RESERVED
  RUNNING
  COMPLETED
}

model BeamHistory {
  id          Int      @id @default(autoincrement())
  beamStockId Int
  beamStock   BeamStock @relation(fields: [beamStockId], references: [id])
  status      BeamStatus
  changedAt   DateTime @default(now())
  changedBy   String?
  remarks     String?
}

model YarnConfirmation {
  id                    Int       @id @default(autoincrement())
  order_no              String    @unique
  ibpo_no               String?
  design_no             String
  customer_name         String
  construction          String?
  order_qty             Float     @default(0)
  required_warp_qty     Float     @default(0)
  confirmed_warp_qty    Float     @default(0)
  received_warp_qty     Float     @default(0)
  balance_warp_qty      Float     @default(0)
  required_weft_qty     Float     @default(0)
  confirmed_weft_qty    Float     @default(0)
  received_weft_qty     Float     @default(0)
  balance_weft_qty      Float     @default(0)
  yarn_status           String    @default("YARN CONFIRMATION PENDING")
  confirmation_type     String?   @default("FULL")
  confirmation_date     DateTime?
  confirmed_by          String?
  expected_receipt_date DateTime?
  remarks               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model SizingConfirmation {
  id                      Int       @id @default(autoincrement())
  order_no                String    @unique
  ibpo_no                 String?
  design_no               String
  customer_name           String
  construction            String?
  warp_required_qty       Float     @default(0)
  warp_confirmed_qty        Float?    @default(0)
  warp_received_qty       Float     @default(0)
  warp_balance_qty          Float?    @default(0)
  sizing_required_qty     Float     @default(0)
  sizing_eligible_qty     Float     @default(0)
  sizing_completed_qty    Float     @default(0)
  sizing_planned_date     DateTime?
  actual_receipt_date     DateTime?
  sizing_completed_date   DateTime?
  status                  String    @default("PENDING")
  remarks                 String?
  confirmed_by            String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model ErpAlert {
  id                Int       @id @default(autoincrement())
  alert_code        String?
  date              DateTime  @default(now())
  department        String    @default("Planning")
  order_no          String?
  design_no         String?
  loom_no           Int?
  beam_no           String?
  priority          String    @default("HIGH PRIORITY")
  message           String
  reason            String?
  suggested_action  String?
  status            String    @default("OPEN")
  acknowledged_by   String?
  acknowledged_date DateTime?
  remarks           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model DelayRecord {
  id               Int       @id @default(autoincrement())
  order_no         String?
  design_no        String?
  loom_no          Int?
  module_type      String    @default("Sizing")
  planned_date     DateTime
  actual_date      DateTime?
  delay_days       Int       @default(0)
  delay_reason     String?
  responsible_dept String?   @default("Sizing")
  suggested_action String?
  recovery_date    DateTime?
  planner_decision String?
  status           String    @default("OPEN")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model DailyReportEntry {
  id               Int      @id @default(autoincrement())
  report_date      String
  department_code  String
  metric_code      String
  metric_name      String
  raw_value        String?
  calculated_value String?
  target_value     Float?
  actual_value     Float?
  diff_value       Float?
  pct_value        Float?
  department_head  String?
  mentor           String?
  performance_mark String?
  remarks          String?
  entered_by       String?  @default("ADMIN")
  status           String   @default("SUBMITTED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([report_date, department_code, metric_code])
  @@index([report_date])
  @@index([department_code])
  @@index([report_date, department_code])
}

model DepartmentMasterInfo {
  department_code String   @id
  department_name String
  department_head String
  mentor          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WarpPreparationProcess {
  id                         Int                @id @default(autoincrement())
  plan_id                    Int?
  loom_no                    Int
  process_type               String             // 'KNOTTING', 'KNOTTING_SORT_CHANGE', 'GAITING'
  suggested_process          String             // 'KNOTTING', 'KNOTTING_SORT_CHANGE / GAITING'
  confirmed_process          String?            // 'KNOTTING', 'KNOTTING_SORT_CHANGE', 'GAITING'
  eligibility_status         String?            // 'ELIGIBLE', 'NOT_ELIGIBLE'
  eligibility_reasons        String?            // Reasons when knotting is not suggested
  current_design             String?
  next_design                String?
  order_no                   String?
  current_ends               Int?
  next_ends                  Int?
  ends_difference            Int?
  current_warp_colours       String?
  next_warp_colours          String?
  current_warp_colour_count  Int?
  next_warp_colour_count     Int?
  set_no                     String?
  beam_no                    String?
  warp_loading_date          DateTime?
  status                     String             @default("PENDING") // 'PENDING', 'IN_PROGRESS', 'COMPLETED'
  process_start_date         DateTime?
  process_start_time         String?
  process_completion_date    DateTime?
  process_completion_time    String?
  responsible_person         String?
  remarks                    String?
  created_by                 String?            @default("System")
  confirmed_by               String?
  confirmed_date             DateTime?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  LoomMaster                 LoomMaster         @relation(fields: [loom_no], references: [loom_no])
  PlannedAssignment          PlannedAssignment? @relation(fields: [plan_id], references: [id])

  @@index([loom_no])
  @@index([plan_id])
  @@index([status])
}

model DailyEntryAlertConfig {
  id                         Int                      @id @default(autoincrement())
  department_code            String                   @unique
  department_name            String
  is_active                  Boolean                  @default(true)
  sender_number              String?
  sender_provider_id         String?
  sender_verification_status String                   @default("NOT_VERIFIED")
  sender_verified_at         DateTime?
  receiver_number            String?
  receiver_number_1          String?
  receiver_number_2          String?
  channel                    String                   @default("WhatsApp")
  start_time                 String                   @default("08:00")
  rapid_start_time           String                   @default("10:30")
  rapid_interval_minutes     Int                      @default(5)
  end_time                   String                   @default("11:00")
  sunday_enabled             Boolean                  @default(false)
  message_template           String?
  final_message_template     String?
  created_at                 DateTime                 @default(now())
  updated_at                 DateTime                 @updatedAt

  logs                       DailyEntryAlertLog[]
  schedules                  DailyEntryAlertSchedule[]

  @@index([department_code])
  @@index([is_active])
}

model DailyEntryAlertSchedule {
  id              Int                   @id @default(autoincrement())
  alert_config_id Int
  slot_time       String
  slot_type       String                @default("NORMAL")
  is_enabled      Boolean               @default(true)
  display_order   Int                   @default(0)
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt

  config          DailyEntryAlertConfig @relation(fields: [alert_config_id], references: [id], onDelete: Cascade)

  @@unique([alert_config_id, slot_time])
  @@index([alert_config_id])
}

model DailyEntryAlertLog {
  id                  Int                    @id @default(autoincrement())
  alert_config_id     Int?
  department_code     String
  alert_date          String
  scheduled_time      String
  sent_at             DateTime               @default(now())
  channel             String                 @default("WhatsApp")
  sender_number       String?
  receiver_number     String?
  status              String
  message             String?
  provider_message_id String?
  provider_status     String?
  error_message       String?
  is_test             Boolean                @default(false)

  config              DailyEntryAlertConfig? @relation(fields: [alert_config_id], references: [id])

  @@index([alert_date])
  @@index([department_code, alert_date])
  @@index([status])
}

// ==========================================
// TOTAL ORDER ALLOCATION SYSTEM (TOA MODULE)
// ==========================================

model ToaOrder {
  id               Int       @id @default(autoincrement())
  ibpo             String    @unique
  customer         String?
  order_no         String?
  sp_no            String
  order_type       String    @default("YD")
  construction     String?
  order_qty             Float
  grey_req              Float?
  grey_completed        Float?    @default(0)
  balance_to_weave      Float?
  current_updated_date  DateTime? @default(now())
  loom_start_date       DateTime?
  loom_runout_date      DateTime?
  days_taken            Int?
  product_group         String?
  ppi                   Int?
  kpx                   Float?
  kpx_factor            Float?    @default(1.0)
  corrected_kpx         Float?
  corrected_kpx_per_day Float?
  tolerance_status      String?   @default("ACTIVE")
  width                 String?
  reed_count            String?
  pick                  String?
  frames                Int?
  weft_colours          Int?
  received_date         DateTime  @default(now())
  target_date           DateTime?
  priority              String    @default("Medium")
  status                String    @default("PENDING")
  allocation_type       String    @default("UNALLOCATED")
  remarks               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  allocations      ToaAllocation[]
  productionLogs   ToaProductionLog[]
  completionReview ToaCompletionReview?

  @@index([ibpo])
  @@index([sp_no])
  @@index([status])
  @@index([received_date])
}

model ToaVendor {
  id                   Int             @id @default(autoincrement())
  vendor_name          String          @unique
  vendor_code          String?         @unique
  contact_person       String?
  phone                String?
  email                String?
  total_declared_looms Int             @default(0)
  remarks              String?
  active               Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  looms                ToaVendorLoom[]
  allocations          ToaAllocation[]

  @@index([vendor_name])
  @@index([active])
}

model ToaVendorLoom {
  id               Int             @id @default(autoincrement())
  vendor_id        Int
  loom_no          String
  loom_type        String?
  width            String?
  max_reed_space   Float?
  frame_capacity   Int?
  max_weft_colours Int?
  max_ppi          Int?
  rpm              Int?
  avg_daily_prod   Float           @default(150.0)
  status           String          @default("AVAILABLE")
  remarks          String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  vendor           ToaVendor       @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  allocations      ToaAllocation[]

  @@unique([vendor_id, loom_no])
  @@index([vendor_id])
  @@index([status])
}

model ToaAllocation {
  id                    Int                @id @default(autoincrement())
  order_id              Int
  ibpo                  String
  allocation_type       String             // "IN_HOUSE" or "VENDOR"
  loom_no               Int?               // References In-House LoomMaster loom_no
  vendor_id             Int?
  vendor_loom_id        Int?
  allocated_meters      Float
  estimated_start_date  DateTime
  estimated_runout_date DateTime
  avg_daily_prod        Float
  days_taken            Int
  status                String             @default("CONFIRMED")
  remarks               String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  order                 ToaOrder           @relation(fields: [order_id], references: [id], onDelete: Cascade)
  vendor                ToaVendor?         @relation(fields: [vendor_id], references: [id])
  vendorLoom            ToaVendorLoom?     @relation(fields: [vendor_loom_id], references: [id])
  productionLogs        ToaProductionLog[]

  @@index([order_id])
  @@index([ibpo])
  @@index([loom_no])
  @@index([vendor_id])
  @@index([status])
}

model ToaProductionLog {
  id              Int            @id @default(autoincrement())
  allocation_id   Int?
  order_id        Int
  ibpo            String
  allocation_type String         // "IN_HOUSE" or "VENDOR"
  loom_no         Int?
  vendor_id       Int?
  vendor_loom_id  Int?
  production_date DateTime
  produced_meter  Float
  entered_by      String         @default("System")
  remarks         String?
  createdAt       DateTime       @default(now())

  order           ToaOrder       @relation(fields: [order_id], references: [id], onDelete: Cascade)
  allocation      ToaAllocation? @relation(fields: [allocation_id], references: [id], onDelete: SetNull)

  @@index([order_id])
  @@index([ibpo])
  @@index([production_date])
  @@index([loom_no])
}

model ToaCompletionReview {
  id                   Int       @id @default(autoincrement())
  order_id             Int       @unique
  ibpo                 String    @unique
  ordered_meter        Float
  in_house_meter       Float     @default(0)
  vendor_meter         Float     @default(0)
  total_produced_meter Float
  variance_meter       Float     // total_produced_meter - ordered_meter
  variance_pct         Float     // (variance_meter / ordered_meter) * 100
  is_approved          Boolean   @default(false)
  approval_reason      String?
  approved_by          String?
  closed_by            String
  closed_at            DateTime  @default(now())
  is_reopened          Boolean   @default(false)
  reopened_by          String?
  reopened_at          DateTime?
  reopen_reason        String?

  order                ToaOrder  @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([ibpo])
}

model ToaAuditLog {
  id        Int      @id @default(autoincrement())
  ibpo      String?
  action    String
  entity    String
  details   String?
  user      String   @default("System")
  timestamp DateTime @default(now())

  @@index([ibpo])
  @@index([action])
  @@index([timestamp])
}






