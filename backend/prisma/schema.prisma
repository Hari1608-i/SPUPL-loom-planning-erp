generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AllocationAuditLog {
  id         Int      @id @default(autoincrement())
  user       String   @default("System")
  timestamp  DateTime @default(now())
  old_plan   String?
  new_plan   String
  reason     String?
  action     String
  loom_no    Int
  design_no  String
}

model BeamStockMaster {
  id                    Int       @id @default(autoincrement())
  date                  DateTime  @default(now())
  design_no             String
  vendor_name           String?
  party_beam_no         String?
  order_no              String?
  ibpo                  String?
  customer              String?
  count                 String?
  ends                  Int?
  beam_dia              Int?
  beam_no               String
  beam_length           Float?
  available_meter       Float
  current_balance_meter Float?
  reserved_meter        Float?    @default(0)
  party                 String?
  set_no                String?
  order_type            String?
  warp_dc_no            String?
  status                String    @default("Available")
  sizing_status         String?   @default("COMPLETED")
  loom_no_assigned      Int?
  beam_type             String?
  beam_width            Float?
  construction          String?
  location              String?
  ready_status          String?
  reed_count            String?
  remarks               String?
  reserved_for          String?
  reserved_status       String?
  reserved_date         DateTime?
  total_warped_meter    Float?
  unit                  String?
  warping_batch_no      String?

  @@index([status])
}

model CompletedWarpHistory {
  id                     Int       @id @default(autoincrement())
  loom_no                Int
  design_no_sp_no        String
  start_date             DateTime
  end_date               DateTime
  warp_meter             Float
  total_production_meter Float
  running_days           Int
  avg_daily_production   Float
  efficiency_pct         Float
  unit                   String
  sort_change_type       String?
  LoomMaster             LoomMaster @relation(fields: [loom_no], references: [loom_no])
}

model DesignMaster {
  design_no_sp_no         String  @id
  construction            String?
  weft_colours            Int
  weft_colour_details     String?
  frames                  Int
  reed_count              String?
  pick                    String?
  greige_width            String?
  total_ends              Int?
  reed_space_warp_width   String
  weave_type              String
  beam_type               String
  crimp_percent           Float
  beam_dia                Int?
  epi                     Int?
  ppi                     Int?
  no_of_clr_warp          Int?
  no_of_clr_weft          Int?
  orders                  OrderMaster[]
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  status                  String @default("ACTIVE")
  remarks                 String?
}

model LoomMaster {
  loom_no                  Int                   @id @default(autoincrement())
  loom_type                String?
  shed                     Int?
  shed_name                String?
  area                     Int?
  installed_date           String?
  rpm                      Int?
  act_rpm                  Int?
  make                     String?
  model                    String?
  motor_kw_hp              String?
  drive                    String?
  control_panel            String?
  weft_colours             Int?
  beam_type                String?
  beam_dia                 Int?
  installed_lever          Int?
  width                    String?
  unit                     String?
  weave                    String?
  frame_capacity           Int?
  max_weft_colours         Int?
  status                   String                @default("Available")
  remarks                  String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @default(now())
  createdBy                String                @default("System")
  modifiedBy               String?
  CompletedWarpHistory     CompletedWarpHistory[]
  LoomRunEntry             LoomRunEntry?
  PlannedAssignment        PlannedAssignment[]
  WarpPreparationProcess WarpPreparationProcess[]
}

model LoomRunEntry {
  id                  Int       @id @default(autoincrement())
  loom_no             Int       @unique
  design_no_sp_no     String?
  current_reed_no     String?
  current_beam_no     String?
  set_no              String?
  beam_id             Int?
  order_no            String?
  customer_name       String?
  loom_start_date     DateTime
  warped_meter        Float
  daily_production    Float
  rpm                 Int?
  efficiency          Float?
  shift_hours         Float?
  working_hours       Float?
  machine_utilization Float?
  production_override Float?
  override_reason     String?
  next_plan_design    String?
  sort_change_type    String?
  prep_status         String?
  remarks             String?
  LoomMaster          LoomMaster @relation(fields: [loom_no], references: [loom_no])
}

model DailyProductionLog {
  id             Int      @id @default(autoincrement())
  date           DateTime @default(now())
  loom_no        Int
  design_no      String
  produced_meter Float
  rpm            Int?
  efficiency     Float?
  remarks        String?
  createdAt      DateTime @default(now())
}

model PlannedAssignment {
  id                           Int       @id @default(autoincrement())
  loom_no                      Int
  current_design               String
  next_design                  String
  order_id                     Int?
  order_no                     String?
  customer_name                String?
  required_qty                 Float?
  required_reed_space          String?
  required_reed_count          String?
  planned_start_date           DateTime
  planned_warp_meter           Float
  planned_avg_daily_production Float
  status                       String    @default("NOT PLANNED")
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @default(now())
  LoomMaster                   LoomMaster @relation(fields: [loom_no], references: [loom_no])
  WarpPreparationProcess WarpPreparationProcess[]
}

model ReedStockMaster {
  id                   Int      @id @default(autoincrement())
  reed_no              String?
  reed_type            String?
  reed_count           String
  reed_space           String?
  reed_width           String?
  reed_dent            String?
  dents_per_inch       Int?
  total_dents          Int?
  reed_make            String?
  vendor               String?
  unit                 String?
  location             String?
  available_qty        Int      @default(1)
  reserved_qty         Int      @default(0)
  running_qty          Int      @default(0)
  damaged_qty          Int      @default(0)
  total_qty            Int      @default(1)
  status               String   @default("Available")
  remarks              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now())
}

model ReedRequirement {
  id                  Int      @id @default(autoincrement())
  order_no            String?
  design_no           String
  loom_no             Int?
  required_reed_count String
  required_reed_space String?
  required_width      String?
  qty                 Int      @default(1)
  required_date       DateTime?
  priority            String   @default("URGENT")
  status              String   @default("REQUIRED")
  remarks             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SystemAuditLog {
  id        Int      @id @default(autoincrement())
  username  String
  screen    String
  action    String
  oldValue  String?
  newValue  String?
  timestamp DateTime @default(now())
}

model User {
  id             Int       @id @default(autoincrement())
  employeeId     String    @unique
  employeeName   String
  username       String    @unique
  email          String?
  mobile         String?
  department     String?
  designation    String?
  password_hash  String
  role           String    @default("VIEWER")
  status         String    @default("ACTIVE")
  failedAttempts Int       @default(0)
  lastLogin      DateTime?
  permissions    String?
  remarks        String?
  createdBy      String    @default("System")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([department])
  @@index([role])
}

model OrderMaster {
  id                        Int       @id @default(autoincrement())
  order_no                  String?
  ibpo_no                   String?
  customer_name             String
  buyer_name                String?
  order_type                String?   @default("GREY")
  combo_pattern             String?
  finish                    String?
  design_no_sp_no           String
  designMaster              DesignMaster @relation(fields: [design_no_sp_no], references: [design_no_sp_no])
  construction              String?
  reed_count                String?
  weave_type                String?
  epi                       Int?
  ppi                       Int?
  total_ends                Int?
  beam_type                 String?
  frames                    Int?
  no_of_clr_warp            Int?
  no_of_clr_weft            Int?
  uom                       String    @default("Meters")
  order_qty                 Float
  produced_qty              Float     @default(0)
  status                    String    @default("ORDER RECEIVED")
  remarks                   String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model DailyReportEntry {
  id               Int      @id @default(autoincrement())
  report_date      String
  department_code  String
  metric_code      String
  metric_name      String
  raw_value        String?
  calculated_value String?
  target_value     Float?
  actual_value     Float?
  diff_value       Float?
  pct_value        Float?
  department_head  String?
  mentor           String?
  performance_mark String?
  remarks          String?
  entered_by       String?  @default("ADMIN")
  status           String   @default("SUBMITTED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([report_date, department_code, metric_code])
  @@index([report_date])
  @@index([department_code])
  @@index([report_date, department_code])
}

model DepartmentMasterInfo {
  department_code String   @id
  department_name String
  department_head String
  mentor          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BeamPreparationRequest {
  id                      Int       @id @default(autoincrement())
  loom_no                 Int
  design_no               String
  target_date             DateTime
  status                  String    @default("WAITING FOR WARPING")
  priority                String    @default("Medium")
  warping_vendor          String?
  warping_dc_no           String?
  warping_batch           String?
  sizing_vendor           String?
  sizing_dc_no            String?
  sizing_machine          String?
  vendor_name             String?
  vendor_beam             String?
  set_no                  String?
  beam_no                 String?
  required_meter          Float?
  actual_meter            Float?
  warping_remarks         String?
  sizing_remarks          String?
  warping_start_date      DateTime?
  warping_completion_date DateTime?
  sizing_start_date       DateTime?
  sizing_completion_date  DateTime?
  beam_ready_date         DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime
}

model WarpPreparationProcess {
  id                         Int                @id @default(autoincrement())
  plan_id                    Int?
  loom_no                    Int
  process_type               String             // 'KNOTTING', 'KNOTTING_SORT_CHANGE', 'GAITING'
  suggested_process          String             // 'KNOTTING', 'KNOTTING_SORT_CHANGE / GAITING'
  confirmed_process          String?            // 'KNOTTING', 'KNOTTING_SORT_CHANGE', 'GAITING'
  eligibility_status         String?            // 'ELIGIBLE', 'NOT_ELIGIBLE'
  eligibility_reasons        String?            // Reasons when knotting is not suggested
  current_design             String?
  next_design                String?
  order_no                   String?
  current_ends               Int?
  next_ends                  Int?
  ends_difference            Int?
  current_warp_colours       String?
  next_warp_colours          String?
  current_warp_colour_count  Int?
  next_warp_colour_count     Int?
  set_no                     String?
  beam_no                    String?
  warp_loading_date          DateTime?
  status                     String             @default("PENDING") // 'PENDING', 'IN_PROGRESS', 'COMPLETED'
  process_start_date         DateTime?
  process_start_time         String?
  process_completion_date    DateTime?
  process_completion_time    String?
  responsible_person         String?
  remarks                    String?
  created_by                 String?            @default("System")
  confirmed_by               String?
  confirmed_date             DateTime?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  LoomMaster                 LoomMaster         @relation(fields: [loom_no], references: [loom_no])
  PlannedAssignment          PlannedAssignment? @relation(fields: [plan_id], references: [id])

  @@index([loom_no])
  @@index([plan_id])
  @@index([status])
}

