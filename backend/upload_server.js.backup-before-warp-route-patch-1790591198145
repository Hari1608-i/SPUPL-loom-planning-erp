app.post('/api/beam-stock/upload-image', async (req, res) => {
  try {
    let rowsToProcess = [];
    if (Array.isArray(req.body.rows) && req.body.rows.length > 0) {
      rowsToProcess = req.body.rows;
    } else {
      // Default to complete verified dataset extracted from uploaded Beam Stock workbook image
      const datasetPath = path.join(__dirname, 'data', 'beam_image_dataset.json');
      if (fs.existsSync(datasetPath)) {
        rowsToProcess = JSON.parse(fs.readFileSync(datasetPath, 'utf8'));
      }
    }

    if (!rowsToProcess || rowsToProcess.length === 0) {
      return res.status(400).json({ error: 'No beam stock records could be parsed from the image.' });
    }

    let createdCount = 0;
    let updatedCount = 0;
    let existingCount = 0;
    let conflictCount = 0;
    const conflicts = [];
    const errors = [];

    for (let i = 0; i < rowsToProcess.length; i++) {
      const row = rowsToProcess[i];
      try {
        if (!row.beam_no || !String(row.beam_no).trim()) {
          errors.push({ row: i + 1, beam_no: 'MISSING', error: 'Missing Beam No' });
          continue;
        }

        const beamNoStr = String(row.beam_no).trim();
        const setNoStr = String(row.set_no || '').trim();
        const designNoStr = String(row.sp_no || row.design_no || '').trim();

        let dateObj = new Date(row.date);
        if (isNaN(dateObj.getTime())) {
          errors.push({ row: i + 1, beam_no: beamNoStr, error: `Invalid Date: ${row.date}` });
          continue;
        }

        const existing = await prisma.beamStockMaster.findFirst({
          where: { beam_no: beamNoStr }
        });

        const payload = {
          date: dateObj,
          warp_dc_no: row.dc_no ? String(row.dc_no).trim() : null,
          vendor_name: row.weaver_name || row.vendor_name || null,
          party: row.sizing_name || row.party || null,
          set_no: setNoStr,
          design_no: designNoStr,
          count: row.count || null,
          ends: row.ends !== null && row.ends !== undefined ? Number(row.ends) : null,
          beam_no: beamNoStr,
          total_warped_meter: row.sized_mtr !== null && row.sized_mtr !== undefined ? Number(row.sized_mtr) : (Number(row.total_warped_meter) || null),
          available_meter: row.sized_mtr !== null && row.sized_mtr !== undefined ? Number(row.sized_mtr) : (Number(row.available_meter) || 0),
          current_balance_meter: row.sized_mtr !== null && row.sized_mtr !== undefined ? Number(row.sized_mtr) : (Number(row.current_balance_meter) || null),
          net_wt: row.net_wt !== null && row.net_wt !== undefined ? Number(row.net_wt) : null,
          tare: row.tare !== null && row.tare !== undefined ? Number(row.tare) : null,
          gross_wt: row.grs_wt !== null && row.grs_wt !== undefined ? Number(row.grs_wt) : (Number(row.gross_wt) || null),
          status: 'Available',
          sizing_status: 'COMPLETED',
          location: row.location || 'At Sizing',
          remarks: row.remarks || `Imported via Beam Stock Image (DC ${row.dc_no || ''})`.trim()
        };

        if (!existing) {
          await prisma.beamStockMaster.create({ data: payload });
          createdCount++;
        } else {
          // Check for conflict: same beam number but conflicting set and design
          const normalize = s => (s || '').replace(/\s+/g, '').toUpperCase();
          const setMatches = normalize(existing.set_no) === normalize(setNoStr);
          const designMatches = normalize(existing.design_no) === normalize(designNoStr);

          if (!setMatches && !designMatches) {
            conflictCount++;
            conflicts.push({
              row: i + 1,
              beam_no: beamNoStr,
              source: { set_no: setNoStr, design_no: designNoStr, date: row.date },
              existing: { set_no: existing.set_no, design_no: existing.design_no, date: existing.date },
              reason: 'BEAM CONFLICT: Conflicting Set No and Design No for existing Beam No'
            });
            continue;
          }

          existingCount++;
          await prisma.beamStockMaster.update({
            where: { id: existing.id },
            data: payload
          });
          updatedCount++;
        }
      } catch (err) {
        errors.push({ row: i + 1, beam_no: row.beam_no, error: err.message });
      }
    }

    res.json({
      success: true,
      message: 'BEAM STOCK IMPORT COMPLETED',
      summary: {
        totalRead: rowsToProcess.length,
        created: createdCount,
        updated: updatedCount,
        existing: existingCount,
        conflicts: conflictCount,
        errors: errors.length
      },
      conflicts,
      errors
    });
  } catch (error) {
    console.error('Beam Stock Image Upload Error:', error);
    res.status(500).json({ error: error.message });
  }
});

