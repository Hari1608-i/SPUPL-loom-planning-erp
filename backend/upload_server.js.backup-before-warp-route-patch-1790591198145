// ----------------------------------------------------
// PASSWORD HELPER
// ----------------------------------------------------

async function safeComparePassword(inputPassword, storedHash) {
  if (!inputPassword || !storedHash) {
    return false;
  }

  if (inputPassword === storedHash) {
    return true;
  }

  try {
    return await bcrypt.compare(
      inputPassword,
      storedHash
    );
  } catch (err) {
    return false;
  }
}

