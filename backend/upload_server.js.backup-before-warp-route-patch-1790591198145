app.get('/api/daily-report', async (req, res) => {
  try {
    const {
      date,
      department,
      startDate,
      endDate
    } = req.query;

    let where = {};

    if (startDate && endDate) {
      where.report_date =
        startDate === endDate
          ? String(startDate)
          : {
              gte: String(startDate),
              lte: String(endDate)
            };
    } else if (date) {
      where.report_date =
        String(date);
    }

    if (department) {
      where.department_code =
        String(department)
          .toUpperCase();
    }

    const entries =
      await prisma.dailyReportEntry.findMany({
        where,

        orderBy: [
          {
            department_code: 'asc'
          },
          {
            id: 'asc'
          }
        ]
      }).catch(() => []);

    const masters =
      await prisma.departmentMasterInfo
        .findMany()
        .catch(() => []);

    res.json({
      entries: entries || [],
      count:
        (entries || []).length,
      departmentMasters:
        masters || []
    });
  } catch (error) {
    res.json({
      entries: [],
      count: 0,
      departmentMasters: []
    });
  }
});

// ----------------------------------------------------
// DAILY REPORT - HISTORY DATES
// ----------------------------------------------------

app.get(
  '/api/daily-report/history-dates',
  async (req, res) => {
    try {
      const rawDates =
        await prisma.dailyReportEntry.groupBy({
          by: [
            'report_date',
            'department_code'
          ],

          _count: {
            id: true
          }
        }).catch(() => []);

      const dateMap =
        new Map();

      (rawDates || []).forEach(
        row => {
          if (
            !dateMap.has(
              row.report_date
            )
          ) {
            dateMap.set(
              row.report_date,
              new Set()
            );
          }

          dateMap
            .get(row.report_date)
            .add(
              row.department_code
            );
        }
      );

      const dates =
        Array.from(
          dateMap.entries()
        )
          .map(
            ([date, departments]) => ({
              date,

              enteredDepartmentsCount:
                departments.size,

              departments:
                Array.from(
                  departments
                )
            })
          )
          .sort(
            (a, b) =>
              b.date.localeCompare(
                a.date
              )
          );

      res.json({
        dates: dates || [],
        count:
          (dates || []).length
      });
    } catch (error) {
      res.json({
        dates: [],
        count: 0
      });
    }
  }
);

// ----------------------------------------------------
// DAILY REPORT - MONTHLY SUMMARY
// ----------------------------------------------------

app.get(
  '/api/daily-report/monthly',
  async (req, res) => {
    try {
      const month =
        String(
          req.query.month || ''
        ).trim();

      const endDateParam =
        String(
          req.query.endDate || ''
        ).trim();

      if (!/^\d{4}-\d{2}$/.test(month)) {
        return res.status(400).json({
          success: false,
          error:
            'Invalid month. Expected YYYY-MM.'
        });
      }

      const [
        year,
        monthNumber
      ] =
        month
          .split('-')
          .map(Number);

      if (
        monthNumber < 1 ||
        monthNumber > 12
      ) {
        return res.status(400).json({
          success: false,
          error: 'Invalid month.'
        });
      }

      const monthStart =
        `${month}-01`;

      const lastDay =
        new Date(
          Date.UTC(
            year,
            monthNumber,
            0
          )
        ).getUTCDate();

      const defaultMonthEnd =
        `${month}-${String(
          lastDay
        ).padStart(2, '0')}`;

      const monthEnd =
        /^\d{4}-\d{2}-\d{2}$/.test(
          endDateParam
        ) &&
        endDateParam >= monthStart &&
        endDateParam <= defaultMonthEnd
          ? endDateParam
          : defaultMonthEnd;

      const entries =
        await prisma.dailyReportEntry.findMany({
          where: {
            report_date: {
              gte: monthStart,
              lte: monthEnd
            }
          },

          orderBy: [
            {
              metric_code: 'asc'
            },
            {
              report_date: 'asc'
            },
            {
              department_code: 'asc'
            },
            {
              id: 'asc'
            }
          ]
        });

      const grouped =
        new Map();

      for (
        const entry of entries
      ) {
        const metricCode =
          String(
            entry.metric_code ||
              ''
          ).trim();

        if (!metricCode) {
          continue;
        }

        if (
          !grouped.has(
            metricCode
          )
        ) {
          grouped.set(
            metricCode,
            {
              metric_code:
                metricCode,

              metric_name:
                entry.metric_name ||
                metricCode,

              actualTotal: 0,

              targetTotal: 0,

              actualDates:
                new Set()
            }
          );
        }

        const item =
          grouped.get(
            metricCode
          );

        const actualValue =
          entry.actual_value !== null &&
          entry.actual_value !== undefined &&
          Number.isFinite(
            Number(
              entry.actual_value
            )
          )
            ? Number(
                entry.actual_value
              )
            : null;

        const targetValue =
          entry.target_value !== null &&
          entry.target_value !== undefined &&
          Number.isFinite(
            Number(
              entry.target_value
            )
          )
            ? Number(
                entry.target_value
              )
            : null;

        if (
          actualValue !== null
        ) {
          item.actualTotal +=
            actualValue;

          item.actualDates.add(
            String(
              entry.report_date
            )
          );
        }

        if (
          targetValue !== null &&
          targetValue > 0
        ) {
          item.targetTotal +=
            targetValue;
        }
      }

      const summary =
        Array.from(
          grouped.values()
        )
          .map(item => {
            const daysEntered =
              item.actualDates.size;

            const monthlyAverage =
              daysEntered > 0
                ? item.actualTotal /
                  daysEntered
                : 0;

            const achievementPct =
              item.targetTotal > 0
                ? (
                    item.actualTotal /
                    item.targetTotal
                  ) * 100
                : null;

            return {
              metric_code:
                item.metric_code,

              metric_name:
                item.metric_name,

              monthlyTotal:
                Number(
                  item.actualTotal.toFixed(
                    2
                  )
                ),

              monthlyAverage:
                Number(
                  monthlyAverage.toFixed(
                    2
                  )
                ),

              achievementPct:
                achievementPct === null
                  ? null
                  : Number(
                      achievementPct.toFixed(
                        2
                      )
                    ),

              targetTotal:
                Number(
                  item.targetTotal.toFixed(
                    2
                  )
                ),

              daysEntered
            };
          })
          .sort(
            (a, b) =>
              String(
                a.metric_code
              ).localeCompare(
                String(
                  b.metric_code
                )
              )
          );

      return res.json({
        success: true,

        month,

        startDate:
          monthStart,

        endDate:
          monthEnd,

        summary,

        count:
          summary.length
      });
    } catch (error) {
      console.error(
        'Monthly Daily Report Error:',
        error
      );

      return res.status(500).json({
        success: false,
        error:
          error.message ||
          'Failed to load monthly daily report'
      });
    }
  }
);

// ----------------------------------------------------
// DAILY REPORT - WEEKLY MATRIX
// ----------------------------------------------------

app.get(
  '/api/daily-report/weekly',
  async (req, res) => {
    try {
      const startDate =
        String(
          req.query.startDate || ''
        ).trim();

      const endDate =
        String(
          req.query.endDate || ''
        ).trim();

      const departmentParam =
        String(
          req.query.department || ''
        ).trim();

      if (
        !/^\d{4}-\d{2}-\d{2}$/.test(
          startDate
        ) ||
        !/^\d{4}-\d{2}-\d{2}$/.test(
          endDate
        )
      ) {
        return res.status(400).json({
          success: false,
          error:
            'Invalid dates. Expected YYYY-MM-DD.'
        });
      }

      if (
        startDate > endDate
      ) {
        return res.status(400).json({
          success: false,
          error:
            'startDate cannot be greater than endDate.'
        });
      }

      const start =
        new Date(
          `${startDate}T00:00:00Z`
        );

      const end =
        new Date(
          `${endDate}T00:00:00Z`
        );

      if (
        Number.isNaN(
          start.getTime()
        ) ||
        Number.isNaN(
          end.getTime()
        )
      ) {
        return res.status(400).json({
          success: false,
          error:
            'Invalid date range.'
        });
      }

      const dates = [];

      for (
        let current =
          new Date(start);

        current <= end;

        current.setUTCDate(
          current.getUTCDate() + 1
        )
      ) {
        dates.push(
          current
            .toISOString()
            .slice(0, 10)
        );
      }

      const where = {
        report_date: {
          gte: startDate,
          lte: endDate
        }
      };

      if (
        departmentParam &&
        departmentParam
          .toUpperCase() !== 'ALL'
      ) {
        where.department_code =
          departmentParam.toUpperCase();
      }

      const entries =
        await prisma.dailyReportEntry.findMany({
          where,

          orderBy: [
            {
              department_code: 'asc'
            },
            {
              metric_code: 'asc'
            },
            {
              report_date: 'asc'
            },
            {
              id: 'asc'
            }
          ]
        });

      const matrixMap =
        new Map();

      for (
        const entry of entries
      ) {
        const departmentCode =
          String(
            entry.department_code ||
              ''
          ).trim();

        const metricCode =
          String(
            entry.metric_code ||
              ''
          ).trim();

        if (!metricCode) {
          continue;
        }

        const rowKey =
          `${departmentCode}__${metricCode}`;

        if (
          !matrixMap.has(
            rowKey
          )
        ) {
          matrixMap.set(
            rowKey,
            {
              department_code:
                departmentCode,

              metric_code:
                metricCode,

              metric_name:
                entry.metric_name ||
                metricCode,

              values: {}
            }
          );
        }

        const row =
          matrixMap.get(
            rowKey
          );

        const actualValue =
          entry.actual_value !== null &&
          entry.actual_value !== undefined &&
          Number.isFinite(
            Number(
              entry.actual_value
            )
          )
            ? Number(
                entry.actual_value
              )
            : null;

        row.values[
          String(
            entry.report_date
          )
        ] = actualValue;
      }

      const matrix =
        Array.from(
          matrixMap.values()
        )
          .map(row => {
            const result = {
              department_code:
                row.department_code,

              metric_code:
                row.metric_code,

              metric_name:
                row.metric_name,

              values: {}
            };

            for (
              const date of dates
            ) {
              const value =
                Object.prototype.hasOwnProperty.call(
                  row.values,
                  date
                )
                  ? row.values[
                      date
                    ]
                  : null;

              result.values[
                date
              ] = value;

              result[
                date
              ] = value;
            }

            return result;
          })
          .sort(
            (a, b) => {
              const departmentCompare =
                String(
                  a.department_code
                ).localeCompare(
                  String(
                    b.department_code
                  )
                );

              if (
                departmentCompare !== 0
              ) {
                return departmentCompare;
              }

              return String(
                a.metric_code
              ).localeCompare(
                String(
                  b.metric_code
                )
              );
            }
          );

      return res.json({
        success: true,

        startDate,

        endDate,

        dates,

        matrix,

        count:
          matrix.length
      });
    } catch (error) {
      console.error(
        'Weekly Daily Report Error:',
        error
      );

      return res.status(500).json({
        success: false,
        error:
          error.message ||
          'Failed to load weekly daily report'
      });
    }
  }
);

