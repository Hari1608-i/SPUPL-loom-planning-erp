# SPU LOOM ERP - BACKEND ENVIRONMENT CONFIGURATION (PRODUCTION TEMPLATE)

# Server Port
PORT=3002

# Node Environment (production / development)
NODE_ENV=production

# Database Connection URL (SQLite or PostgreSQL)
DATABASE_URL="file:./dev.db"

# JWT Secret Key for Session Authentication (Change to a strong random 64-char key in production!)
JWT_SECRET="spu_loom_erp_super_secret_key_2026_change_in_prod"

# Default System Administrator Account (Seed Settings)
DEFAULT_ADMIN_USERNAME="Admin"
DEFAULT_ADMIN_PASSWORD="!@#$%open"

# Production Frontend Domain
FRONTEND_URL="https://loomplanning.santhiprocessing.com"

# Allowed CORS Origin (Frontend domain or domain array)
CORS_ORIGIN="https://loomplanning.santhiprocessing.com"
