{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,

  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",

  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "backend/**"
    }
  },

  "routes": [
    {
      "src": "^/api/?$",
      "dest": "/api/index.js"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/index.js?path=$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}