{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,

  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",

  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "backend/**"
    }
  },

  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}